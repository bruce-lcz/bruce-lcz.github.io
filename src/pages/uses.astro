---
import BaseLayout from '../layouts/BaseLayout.astro';
import { USES } from '../data/uses';
---

<BaseLayout
  title="Use — Bruce Cheng | Tech Stack"
  description="Tools, frameworks, and technologies I use to build AI applications."
>
  <div class="mx-auto max-w-5xl px-6 py-12 md:py-20">
    <!-- Header -->
    <div class="mb-16 max-w-2xl">
      <p class="editorial-kicker" id="uses-kicker">Tech Stack</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-gray-900 md:text-5xl" id="uses-title">
        What I Use
      </h1>
      <p class="mt-5 text-lg leading-8 text-gray-600" id="uses-subtitle">
        A living list of the tools, frameworks, and technologies I rely on to build AI applications and workflows.
      </p>
    </div>

    <!-- Categories -->
    <div class="flex flex-col gap-16">
      {USES.map((category) => (
        <section>
          <div class="mb-6">
            <h2 class="text-2xl font-semibold tracking-tight text-gray-900">
              <span class="uses-cat-title-en">{category.titleEn}</span>
              <span class="uses-cat-title-zh hidden">{category.titleZh}</span>
            </h2>
            <p class="mt-2 text-sm text-gray-500">
              <span class="uses-cat-desc-en">{category.descriptionEn}</span>
              <span class="uses-cat-desc-zh hidden">{category.descriptionZh}</span>
            </p>
          </div>
          
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {category.tools.map((tool) => (
              <div class="group flex flex-col rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:border-primary/30 hover:shadow-md">
                <h3 class="text-base font-medium text-gray-900 group-hover:text-primary transition-colors">
                  {tool.name}
                </h3>
                <p class="mt-2 text-sm text-gray-500 leading-relaxed">
                  <span class="uses-tool-desc-en">{tool.descriptionEn}</span>
                  <span class="uses-tool-desc-zh hidden">{tool.descriptionZh}</span>
                </p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  function updateUsesPageLang() {
    const lang = localStorage.getItem('language') || 'en';
    const isZh = lang === 'zh';

    const kicker = document.getElementById('uses-kicker');
    const title = document.getElementById('uses-title');
    const subtitle = document.getElementById('uses-subtitle');

    if (kicker) kicker.textContent = isZh ? '技術棧' : 'Tech Stack';
    if (title) title.textContent = isZh ? '使用工具' : 'What I Use';
    if (subtitle) subtitle.textContent = isZh
      ? '我用來建構 AI 應用與工作流的工具、框架與技術清單。'
      : 'A living list of the tools, frameworks, and technologies I rely on to build AI applications and workflows.';

    // Category titles and descriptions
    document.querySelectorAll('.uses-cat-title-en').forEach(el => el.classList.toggle('hidden', isZh));
    document.querySelectorAll('.uses-cat-title-zh').forEach(el => el.classList.toggle('hidden', !isZh));
    document.querySelectorAll('.uses-cat-desc-en').forEach(el => el.classList.toggle('hidden', isZh));
    document.querySelectorAll('.uses-cat-desc-zh').forEach(el => el.classList.toggle('hidden', !isZh));

    // Tool descriptions
    document.querySelectorAll('.uses-tool-desc-en').forEach(el => el.classList.toggle('hidden', isZh));
    document.querySelectorAll('.uses-tool-desc-zh').forEach(el => el.classList.toggle('hidden', !isZh));
  }

  updateUsesPageLang();
  window.addEventListener('storage', updateUsesPageLang);
</script>
