---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UNIFIED_PROJECTS } from '../../data/projects';

export function getStaticPaths() {
  return UNIFIED_PROJECTS.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.translations.en.title} — Bruce Cheng`}
  description={project.translations.en.shortDescription}
>
  <div class="mx-auto max-w-6xl px-6 py-12 md:py-20">
    <!-- Breadcrumb -->
    <nav class="mb-8 flex items-center text-sm font-medium text-gray-500">
      <a href="/projects" class="hover:text-primary transition-colors">
        <span class="proj-en">Projects</span>
        <span class="proj-zh hidden">專案</span>
      </a>
      <svg class="mx-2 h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
      </svg>
      <span class="text-gray-900 truncate">
        <span class="proj-en">{project.translations.en.title}</span>
        <span class="proj-zh hidden">{project.translations.zh.title}</span>
      </span>
    </nav>

    <!-- Header -->
    <header class="mb-12">
      <div class="mb-6 flex flex-wrap gap-2">
        {project.heroBadges?.map((badge) => (
          <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
            {badge}
          </span>
        ))}
      </div>
      
      <h1 class="mb-6 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl md:text-5xl">
        <span class="proj-en">{project.translations.en.title}</span>
        <span class="proj-zh hidden">{project.translations.zh.title}</span>
      </h1>
      
      <p class="mb-8 text-xl leading-relaxed text-gray-600">
        <span class="proj-en">{project.translations.en.description}</span>
        <span class="proj-zh hidden">{project.translations.zh.description}</span>
      </p>

      <div class="flex flex-wrap gap-x-8 gap-y-4 border-y border-gray-200 py-4 text-sm">
        <div>
          <span class="block font-semibold text-gray-900">
            <span class="proj-en">Role</span>
            <span class="proj-zh hidden">角色</span>
          </span>
          <span class="text-gray-600">
            <span class="proj-en">{project.translations.en.role}</span>
            <span class="proj-zh hidden">{project.translations.zh.role}</span>
          </span>
        </div>
        <div>
          <span class="block font-semibold text-gray-900">
            <span class="proj-en">Timeline</span>
            <span class="proj-zh hidden">時間</span>
          </span>
          <span class="font-mono text-gray-600">{project.period}</span>
        </div>
        {project.translations.en.company && (
          <div>
            <span class="block font-semibold text-gray-900">
              <span class="proj-en">Company</span>
              <span class="proj-zh hidden">公司</span>
            </span>
            <span class="text-gray-600">
              <span class="proj-en">{project.translations.en.company}</span>
              <span class="proj-zh hidden">{project.translations.zh.company}</span>
            </span>
          </div>
        )}
      </div>
    </header>

    <!-- Hero Image -->
    {project.heroImage && (
      <div class="mb-16 overflow-hidden rounded-2xl bg-gray-50 shadow-sm border border-gray-100">
        <img src={project.heroImage} alt="" class="w-full h-auto object-contain" />
      </div>
    )}

    <!-- Narrative Sections -->
    <div class="prose prose-lg prose-gray max-w-none">
      
      {/* Before / After Summary */}
      {(project.translations.en.beforeSummary || project.translations.en.afterSummary) && (
        <div class="not-prose mb-12 grid gap-6 md:grid-cols-2">
          {project.translations.en.beforeSummary && (
            <div class="rounded-2xl bg-gray-50 p-6 border border-gray-200">
              <h3 class="mb-3 text-sm font-bold uppercase tracking-widest text-gray-500">
                <span class="proj-en">Before</span>
                <span class="proj-zh hidden">問題</span>
              </h3>
              <p class="text-gray-700">
                <span class="proj-en">{project.translations.en.beforeSummary}</span>
                <span class="proj-zh hidden">{project.translations.zh.beforeSummary}</span>
              </p>
            </div>
          )}
          {project.translations.en.afterSummary && (
            <div class="rounded-2xl bg-primary/5 p-6 border border-primary/10">
              <h3 class="mb-3 text-sm font-bold uppercase tracking-widest text-primary">
                <span class="proj-en">After</span>
                <span class="proj-zh hidden">解決方案</span>
              </h3>
              <p class="text-gray-900">
                <span class="proj-en">{project.translations.en.afterSummary}</span>
                <span class="proj-zh hidden">{project.translations.zh.afterSummary}</span>
              </p>
            </div>
          )}
        </div>
      )}

      {/* Context */}
      {project.translations.en.context && project.translations.en.context.length > 0 && (
        <>
          <h2>
            <span class="proj-en">Context & Background</span>
            <span class="proj-zh hidden">背景脈絡</span>
          </h2>
          <ul>
            {project.translations.en.context.map((text, i) => (
              <li>
                <span class="proj-en">{text}</span>
                <span class="proj-zh hidden">{project.translations.zh.context?.[i]}</span>
              </li>
            ))}
          </ul>
        </>
      )}

      {/* Constraints */}
      {project.translations.en.constraint && project.translations.en.constraint.length > 0 && (
        <>
          <h2>
            <span class="proj-en">Constraints</span>
            <span class="proj-zh hidden">限制條件</span>
          </h2>
          <ul>
            {project.translations.en.constraint.map((text, i) => (
              <li>
                <span class="proj-en">{text}</span>
                <span class="proj-zh hidden">{project.translations.zh.constraint?.[i]}</span>
              </li>
            ))}
          </ul>
        </>
      )}

      {/* System Design / Implementation */}
      {project.translations.en.systemDesign && project.translations.en.systemDesign.length > 0 && (
        <>
          <h2>
            <span class="proj-en">System Design</span>
            <span class="proj-zh hidden">系統設計</span>
          </h2>
          <ul>
            {project.translations.en.systemDesign.map((text, i) => (
              <li>
                <span class="proj-en">{text}</span>
                <span class="proj-zh hidden">{project.translations.zh.systemDesign?.[i]}</span>
              </li>
            ))}
          </ul>
        </>
      )}
      
      {/* Implementation Highlights */}
      {project.translations.en.implementationHighlights && project.translations.en.implementationHighlights.length > 0 && (
        <>
          <h2>
            <span class="proj-en">Implementation Highlights</span>
            <span class="proj-zh hidden">實作重點</span>
          </h2>
          <ul>
            {project.translations.en.implementationHighlights.map((text, i) => (
              <li>
                <span class="proj-en">{text}</span>
                <span class="proj-zh hidden">{project.translations.zh.implementationHighlights?.[i]}</span>
              </li>
            ))}
          </ul>
        </>
      )}

      {/* Outcomes & Impact */}
      {(project.translations.en.outcome || project.translations.en.impact) && (
        <>
          <h2>
            <span class="proj-en">Outcome & Impact</span>
            <span class="proj-zh hidden">成果與影響</span>
          </h2>
          <ul>
            {(project.translations.en.outcome || project.translations.en.impact || []).map((text, i) => {
              const zhText = (project.translations.zh.outcome || project.translations.zh.impact || [])[i];
              return (
                <li>
                  <span class="proj-en">{text}</span>
                  <span class="proj-zh hidden">{zhText}</span>
                </li>
              );
            })}
          </ul>
        </>
      )}
      
      {/* Tech Stack */}
      <h2>
        <span class="proj-en">Tech Stack</span>
        <span class="proj-zh hidden">技術棧</span>
      </h2>
      <div class="not-prose flex flex-wrap gap-2 mt-4">
        {project.techStack.map(tech => (
          <span class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-1.5 text-sm font-medium text-gray-700">
            {tech}
          </span>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  function updateProjectDetailPageLang() {
    const lang = localStorage.getItem('language') || 'en';
    const isZh = lang === 'zh';

    document.querySelectorAll('.proj-en').forEach(el => el.classList.toggle('hidden', isZh));
    document.querySelectorAll('.proj-zh').forEach(el => el.classList.toggle('hidden', !isZh));
  }

  updateProjectDetailPageLang();
  window.addEventListener('storage', updateProjectDetailPageLang);
</script>
