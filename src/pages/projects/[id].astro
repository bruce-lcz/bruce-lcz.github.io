---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UNIFIED_PROJECTS } from '../../data/projects';
import { WORKFLOW_DEFINITIONS } from '../../data/workflows';
import { renderInlineCode } from '../../utils/inlineCode.mjs';
import WorkflowDiagram from '../../components/WorkflowDiagram.astro';

export function getStaticPaths() {
  return UNIFIED_PROJECTS.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const companyTag = project.companyId === 'pixart' ? 'PixArt' : project.translations.en.company;
const renderProjectText = (text?: string) => (text ? renderInlineCode(text) : []);
const englishTranslation = project.translations.en;
const chineseTranslation = project.translations.zh;
const problemSolvedEn = englishTranslation.problemSolved ?? englishTranslation.challenges ?? [];
const problemSolvedZh = chineseTranslation.problemSolved ?? chineseTranslation.challenges ?? [];
const workflowStepsEn = (englishTranslation.systemDesign ?? englishTranslation.implementationHighlights ?? englishTranslation.context ?? []).slice(0, 6);
const workflowStepsZh = (chineseTranslation.systemDesign ?? chineseTranslation.implementationHighlights ?? chineseTranslation.context ?? []).slice(0, 6);
const workflow = WORKFLOW_DEFINITIONS[project.id];
---

<BaseLayout
  title={`${project.translations.en.title} — Bruce Cheng`}
  description={project.translations.en.shortDescription}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12 md:py-20">
    <!-- Breadcrumb -->
    <nav class="mb-8 flex min-w-0 items-center text-sm font-medium text-gray-500" aria-label="Breadcrumb">
      <a href="/projects" class="hover:text-primary transition-colors">
        <span class="proj-en">Projects</span>
        <span class="proj-zh hidden">專案</span>
      </a>
      <svg class="mx-2 h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
      </svg>
      <span class="min-w-0 flex-1 truncate text-gray-900">
        <span class="proj-en">{project.translations.en.title}</span>
        <span class="proj-zh hidden">{project.translations.zh.title}</span>
      </span>
    </nav>

    <!-- Header -->
    <header class="mb-12">
      <div class="mb-6 flex flex-wrap gap-2">
        {project.heroBadges?.map((badge) => (
          <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
            {badge}
          </span>
        ))}
      </div>
      
      <h1 class="mb-6 break-words text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl md:text-5xl">
        <span class="proj-en">{project.translations.en.title}</span>
        <span class="proj-zh hidden">{project.translations.zh.title}</span>
      </h1>
      
      <p class="mb-8 break-words text-lg leading-relaxed text-gray-600 sm:text-xl">
        <span class="proj-en">{project.translations.en.description}</span>
        <span class="proj-zh hidden">{project.translations.zh.description}</span>
      </p>

      <div class="flex flex-wrap gap-2 text-sm [overflow-wrap:anywhere]">
        <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1.5 font-medium text-gray-700">
          <span class="proj-en">{project.translations.en.role}</span>
          <span class="proj-zh hidden">{project.translations.zh.role}</span>
        </span>
        <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1.5 font-mono text-gray-700">{project.period}</span>
        {companyTag && (
          <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1.5 font-medium text-gray-700">
            {companyTag}
          </span>
        )}
      </div>
    </header>

    <!-- Hero Workflow -->
    {project.heroImage && (
      <figure class="mb-12 sm:mb-16">
        <div class="hidden overflow-hidden rounded-2xl border border-gray-100 bg-gray-50 shadow-sm xl:relative xl:left-1/2 xl:block xl:w-[calc(100vw-4rem)] xl:max-w-[90rem] xl:-translate-x-1/2">
          {workflow ? (
            <WorkflowDiagram workflow={workflow} label={project.translations.en.title} labelZh={project.translations.zh.title} />
          ) : (
            <img src={project.heroImage} alt={`${project.translations.en.title} workflow overview`} loading="lazy" class="block h-auto w-full max-w-full object-contain" decoding="async" />
          )}
        </div>
        <div class="rounded-2xl border border-gray-100 bg-gray-50 p-5 shadow-sm xl:hidden">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Workflow summary / 流程摘要</p>
          <ol class="mt-4 space-y-3">
            {workflowStepsEn.map((step, index) => (
              <li class="flex items-start gap-3 text-sm leading-6 text-gray-700">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary">{index + 1}</span>
                <span class="proj-en">{renderProjectText(step).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
                <span class="proj-zh hidden">{renderProjectText(workflowStepsZh[index]).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
              </li>
            ))}
          </ol>
          <p class="mt-4 text-xs leading-5 text-gray-500">The full workflow diagram is available on larger screens. / 完整流程圖請在較大螢幕查看。</p>
        </div>
        <figcaption class="mt-3 text-sm leading-6 text-gray-500">
          <span class="proj-en">Workflow overview. Some names and data are anonymized or recreated for confidentiality.</span>
          <span class="proj-zh hidden">流程概覽；部分名稱與資料因保密需求已匿名化或重新製作。</span>
        </figcaption>
      </figure>
    )}

    <!-- Narrative Sections -->
    <div class="prose prose-lg prose-gray max-w-none">
      
      {/* Before / After Summary */}
      {(project.translations.en.beforeSummary || project.translations.en.afterSummary) && (
        <div class="not-prose mb-12 grid gap-6 md:grid-cols-2">
          {project.translations.en.beforeSummary && (
            <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5 sm:p-6">
              <h3 class="mb-3 text-sm font-bold uppercase tracking-widest text-gray-500">
                <span class="proj-en">Before</span>
                <span class="proj-zh hidden">問題</span>
              </h3>
              <p class="text-gray-700">
                <span class="proj-en">{project.translations.en.beforeSummary}</span>
                <span class="proj-zh hidden">{project.translations.zh.beforeSummary}</span>
              </p>
            </div>
          )}
          {project.translations.en.afterSummary && (
            <div class="rounded-2xl border border-primary/10 bg-primary/5 p-5 sm:p-6">
              <h3 class="mb-3 text-sm font-bold uppercase tracking-widest text-primary">
                <span class="proj-en">After</span>
                <span class="proj-zh hidden">解決方案</span>
              </h3>
              <p class="text-gray-900">
                <span class="proj-en">{project.translations.en.afterSummary}</span>
                <span class="proj-zh hidden">{project.translations.zh.afterSummary}</span>
              </p>
            </div>
          )}
        </div>
      )}

      {/* Context */}
      {project.translations.en.context && project.translations.en.context.length > 0 && (
        <>
          <h2>
            <span class="proj-en">Context & Background</span>
            <span class="proj-zh hidden">背景脈絡</span>
          </h2>
          <ul>
            {project.translations.en.context.map((text, i) => (
              <li>
                <span class="proj-en">{renderProjectText(text).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
                <span class="proj-zh hidden">{renderProjectText(project.translations.zh.context?.[i]).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
              </li>
            ))}
          </ul>
        </>
      )}

      {/* Constraints */}
      {project.translations.en.constraint && project.translations.en.constraint.length > 0 && (
        <>
          <h2>
            <span class="proj-en">Constraints</span>
            <span class="proj-zh hidden">限制條件</span>
          </h2>
          <ul>
            {project.translations.en.constraint.map((text, i) => (
              <li>
                <span class="proj-en">{renderProjectText(text).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
                <span class="proj-zh hidden">{renderProjectText(project.translations.zh.constraint?.[i]).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
              </li>
            ))}
          </ul>
        </>
      )}

      {/* Problem Solved */}
      {problemSolvedEn.length > 0 && (
        <>
          <h2>
            <span class="proj-en">Problem Solved</span>
            <span class="proj-zh hidden">解決的問題</span>
          </h2>
          <ul>
            {problemSolvedEn.map((text, i) => (
              <li>
                <span class="proj-en">{renderProjectText(text).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
                <span class="proj-zh hidden">{renderProjectText(problemSolvedZh[i]).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
              </li>
            ))}
          </ul>
        </>
      )}

      {/* My Role */}
      {project.translations.en.myRole && project.translations.en.myRole.length > 0 && (
        <>
          <h2>
            <span class="proj-en">My Role</span>
            <span class="proj-zh hidden">我的角色</span>
          </h2>
          <ul>
            {project.translations.en.myRole.map((text, i) => (
              <li>
                <span class="proj-en">{renderProjectText(text).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
                <span class="proj-zh hidden">{renderProjectText(project.translations.zh.myRole?.[i]).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
              </li>
            ))}
          </ul>
        </>
      )}

      {/* System Design / Implementation */}
      {project.translations.en.systemDesign && project.translations.en.systemDesign.length > 0 && (
        <>
          <h2>
            <span class="proj-en">System Design</span>
            <span class="proj-zh hidden">系統設計</span>
          </h2>
          <ul>
            {project.translations.en.systemDesign.map((text, i) => (
              <li>
                <span class="proj-en">{renderProjectText(text).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
                <span class="proj-zh hidden">{renderProjectText(project.translations.zh.systemDesign?.[i]).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
              </li>
            ))}
          </ul>
        </>
      )}
      
      {/* Implementation Highlights */}
      {project.translations.en.implementationHighlights && project.translations.en.implementationHighlights.length > 0 && (
        <>
          <h2>
            <span class="proj-en">Implementation Highlights</span>
            <span class="proj-zh hidden">實作重點</span>
          </h2>
          <ul>
            {project.translations.en.implementationHighlights.map((text, i) => (
              <li>
                <span class="proj-en">{renderProjectText(text).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
                <span class="proj-zh hidden">{renderProjectText(project.translations.zh.implementationHighlights?.[i]).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
              </li>
            ))}
          </ul>
        </>
      )}

      {/* Outcomes & Impact */}
      {(project.translations.en.outcome || project.translations.en.impact) && (
        <>
          <h2>
            <span class="proj-en">Outcome & Impact</span>
            <span class="proj-zh hidden">成果與影響</span>
          </h2>
          <ul>
            {(project.translations.en.outcome || project.translations.en.impact || []).map((text, i) => {
              const zhText = (project.translations.zh.outcome || project.translations.zh.impact || [])[i];
              return (
                <li>
                  <span class="proj-en">{renderProjectText(text).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
                  <span class="proj-zh hidden">{renderProjectText(zhText).map((fragment) => fragment.type === 'code' ? <code>{fragment.value}</code> : fragment.value)}</span>
                </li>
              );
            })}
          </ul>
        </>
      )}
      
      {/* Tech Stack */}
      <h2>
        <span class="proj-en">Tech Stack</span>
        <span class="proj-zh hidden">技術與工具</span>
      </h2>
      <div class="not-prose mt-4 flex flex-wrap gap-2 [overflow-wrap:anywhere]">
        {project.techStack.map(tech => (
          <span class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-1.5 text-sm font-medium text-gray-700">
            {tech}
          </span>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  function updateProjectDetailPageLang() {
    const lang = localStorage.getItem('language') || 'en';
    const isZh = lang === 'zh';

    document.querySelectorAll('.proj-en').forEach(el => el.classList.toggle('hidden', isZh));
    document.querySelectorAll('.proj-zh').forEach(el => el.classList.toggle('hidden', !isZh));
  }

  updateProjectDetailPageLang();
  window.addEventListener('storage', updateProjectDetailPageLang);
  window.addEventListener('languagechange', updateProjectDetailPageLang);
</script>
