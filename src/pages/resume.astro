---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Resume & CV — Bruce Cheng | Enterprise AI Architecture & LLM Systems"
  description="Resume and Curriculum Vitae of Bruce Cheng, an AI Application Engineer focused on enterprise AI architecture and LLM systems."
>
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-20">
    <!-- Header -->
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="editorial-kicker" id="resume-kicker">Professional Profiles</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-gray-900 md:text-5xl" id="resume-title">
          Resume & CV
        </h1>
        <p class="mt-5 text-lg leading-8 text-gray-600" id="resume-subtitle">
          A concise profile of my enterprise AI architecture, LLM systems, experience, education, and selected projects.
        </p>
      </div>
      
      <a
        id="download-btn"
        href="/Bruce_Cheng_Resume.pdf"
        download="Bruce_Cheng_Resume.pdf"
        class="inline-flex min-h-11 items-center gap-2 rounded-full bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-gray-800 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 shrink-0 self-start md:self-auto"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span id="resume-download-text">Download PDF</span>
      </a>
    </div>

    <!-- Tabs -->
    <div class="mb-6 flex gap-6 border-b border-gray-200" role="tablist" aria-label="Resume documents">
      <button 
        id="tab-resume" 
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="resume-panel"
        class="min-h-11 border-b-2 border-gray-900 pb-3 text-lg font-semibold text-gray-900 transition-colors"
      >
        Resume
      </button>
      <button 
        id="tab-cv" 
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="resume-panel"
        class="min-h-11 border-b-2 border-transparent pb-3 text-lg font-medium text-gray-500 transition-colors hover:text-gray-900"
      >
        CV
      </button>
    </div>

    <!-- PDF Viewer -->
    <div id="resume-panel" role="tabpanel" aria-labelledby="tab-resume" class="rounded-2xl border border-gray-200 bg-gray-50/50 p-2 shadow-sm md:p-4">
      <div class="rounded-xl border border-gray-200 bg-white p-6 text-center shadow-sm sm:hidden">
        <p class="text-sm leading-7 text-gray-600" id="mobile-pdf-text">
          Open the PDF in a new tab or download it to view on mobile.
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a id="mobile-open-btn" href="/Bruce_Cheng_Resume.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-center rounded-full bg-gray-900 px-5 py-3 text-sm font-semibold text-white">Open PDF</a>
          <a id="mobile-download-btn" href="/Bruce_Cheng_Resume.pdf" download="Bruce_Cheng_Resume.pdf" class="inline-flex min-h-11 items-center justify-center rounded-full border border-gray-200 px-5 py-3 text-sm font-semibold text-gray-700">Download</a>
        </div>
      </div>
      <div class="relative hidden w-full overflow-hidden rounded-xl bg-white shadow-sm sm:block" style="height: 80vh; min-height: 600px;">
        <object
          id="pdf-viewer"
          data="/Bruce_Cheng_Resume.pdf"
          type="application/pdf"
          class="absolute inset-0 h-full w-full"
        >
          <div class="flex h-full flex-col items-center justify-center p-6 text-center">
            <svg class="mb-4 h-12 w-12 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            <p class="mb-4 text-gray-500" id="resume-fallback-text">
              Your browser does not support inline PDFs. Please download the PDF to view it.
            </p>
            <a
              id="fallback-download-btn"
              href="/Bruce_Cheng_Resume.pdf"
              download="Bruce_Cheng_Resume.pdf"
              class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
            >
              Download PDF
            </a>
          </div>
        </object>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function updateResumePageLang() {
    const lang = localStorage.getItem('language') || 'en';
    const isZh = lang === 'zh';

    const kicker = document.getElementById('resume-kicker');
    const title = document.getElementById('resume-title');
    const subtitle = document.getElementById('resume-subtitle');
    const downloadText = document.getElementById('resume-download-text');
    const fallbackText = document.getElementById('resume-fallback-text');
    const mobilePdfText = document.getElementById('mobile-pdf-text');
    const mobileOpenBtn = document.getElementById('mobile-open-btn');
    const mobileDownloadBtn = document.getElementById('mobile-download-btn');
    const tabResume = document.getElementById('tab-resume');
    const tabCv = document.getElementById('tab-cv');

    if (kicker) kicker.textContent = isZh ? '專業履歷' : 'Professional Profiles';
    if (title) title.textContent = isZh ? '履歷與 CV' : 'Resume & CV';
    if (subtitle) subtitle.textContent = isZh
      ? '企業 AI 架構、LLM 系統、工作經驗、學歷與代表專案摘要。'
      : 'A concise profile of my enterprise AI architecture, LLM systems, experience, education, and selected projects.';
    if (downloadText) downloadText.textContent = isZh ? '下載 PDF' : 'Download PDF';
    if (fallbackText) fallbackText.textContent = isZh 
      ? '您的瀏覽器不支援內嵌 PDF，請下載後檢視。' 
      : 'Your browser does not support inline PDFs. Please download the PDF to view it.';
    if (mobilePdfText) mobilePdfText.textContent = isZh
      ? '手機版建議在新分頁開啟 PDF，或直接下載檔案。'
      : 'Open the PDF in a new tab or download it to view on mobile.';
    if (mobileOpenBtn) mobileOpenBtn.textContent = isZh ? '開啟 PDF' : 'Open PDF';
    if (mobileDownloadBtn) mobileDownloadBtn.textContent = isZh ? '下載' : 'Download';
    
    if (tabResume) tabResume.textContent = isZh ? '履歷（Resume）' : 'Resume';
    if (tabCv) tabCv.textContent = isZh ? '詳細履歷（CV）' : 'CV';
  }

  function switchTab(docType: string) {
    const tabResume = document.getElementById('tab-resume');
    const tabCv = document.getElementById('tab-cv');
    const pdfViewer = document.getElementById('pdf-viewer');
    const downloadBtn = document.getElementById('download-btn');
    const fallbackDownloadBtn = document.getElementById('fallback-download-btn');
    const mobileOpenBtn = document.getElementById('mobile-open-btn');
    const mobileDownloadBtn = document.getElementById('mobile-download-btn');
    const resumePanel = document.getElementById('resume-panel');

    tabResume?.setAttribute('aria-selected', String(docType === 'resume'));
    tabCv?.setAttribute('aria-selected', String(docType === 'cv'));

    // Update active tab styles
    if (docType === 'resume') {
      if (tabResume) tabResume.className = "min-h-11 border-b-2 border-gray-900 pb-3 text-lg font-semibold text-gray-900 transition-colors";
      if (tabCv) tabCv.className = "min-h-11 border-b-2 border-transparent pb-3 text-lg font-medium text-gray-500 transition-colors hover:text-gray-900";
      
      const fileUrl = "/Bruce_Cheng_Resume.pdf";
      if (pdfViewer) pdfViewer.setAttribute('data', fileUrl);
      if (downloadBtn) {
        downloadBtn.setAttribute('href', fileUrl);
        downloadBtn.setAttribute('download', "Bruce_Cheng_Resume.pdf");
      }
      if (fallbackDownloadBtn) {
        fallbackDownloadBtn.setAttribute('href', fileUrl);
        fallbackDownloadBtn.setAttribute('download', "Bruce_Cheng_Resume.pdf");
      }
      if (mobileOpenBtn) mobileOpenBtn.setAttribute('href', fileUrl);
      if (mobileDownloadBtn) {
        mobileDownloadBtn.setAttribute('href', fileUrl);
        mobileDownloadBtn.setAttribute('download', "Bruce_Cheng_Resume.pdf");
      }
      resumePanel?.setAttribute('aria-labelledby', 'tab-resume');
    } else {
      if (tabCv) tabCv.className = "min-h-11 border-b-2 border-gray-900 pb-3 text-lg font-semibold text-gray-900 transition-colors";
      if (tabResume) tabResume.className = "min-h-11 border-b-2 border-transparent pb-3 text-lg font-medium text-gray-500 transition-colors hover:text-gray-900";
      
      const fileUrl = "/Bruce_Cheng_CV.pdf";
      if (pdfViewer) pdfViewer.setAttribute('data', fileUrl);
      if (downloadBtn) {
        downloadBtn.setAttribute('href', fileUrl);
        downloadBtn.setAttribute('download', "Bruce_Cheng_CV.pdf");
      }
      if (fallbackDownloadBtn) {
        fallbackDownloadBtn.setAttribute('href', fileUrl);
        fallbackDownloadBtn.setAttribute('download', "Bruce_Cheng_CV.pdf");
      }
      if (mobileOpenBtn) mobileOpenBtn.setAttribute('href', fileUrl);
      if (mobileDownloadBtn) {
        mobileDownloadBtn.setAttribute('href', fileUrl);
        mobileDownloadBtn.setAttribute('download', "Bruce_Cheng_CV.pdf");
      }
      resumePanel?.setAttribute('aria-labelledby', 'tab-cv');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateResumePageLang();
    window.addEventListener('storage', updateResumePageLang);
    window.addEventListener('languagechange', updateResumePageLang);

    const tabResume = document.getElementById('tab-resume');
    const tabCv = document.getElementById('tab-cv');

    if (tabResume) tabResume.addEventListener('click', () => switchTab('resume'));
    if (tabCv) tabCv.addEventListener('click', () => switchTab('cv'));
  });
</script>
