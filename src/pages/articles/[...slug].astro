---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getTranslation, isPublished, sortArticles } from '../../utils/articles';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const allArticles = await getCollection('articles');
  const visibleArticles = sortArticles(allArticles.filter(isPublished));

  return visibleArticles.map((entry: CollectionEntry<'articles'>) => {
    const sameLanguageArticles = visibleArticles.filter(
      (article) => article.data.lang === entry.data.lang,
    );
    const index = sameLanguageArticles.findIndex((article) => article.id === entry.id);

    return {
      params: { slug: entry.id },
      props: {
        entry,
        prevArticle: index < sameLanguageArticles.length - 1 ? sameLanguageArticles[index + 1] : null,
        nextArticle: index > 0 ? sameLanguageArticles[index - 1] : null,
        allArticles: visibleArticles,
      },
    };
  });
}

// Retain the generated article paths so old links receive a redirect, but do
// not render article content while the blog is disabled.
return Astro.redirect('/about/', 301);

type Props = {
  entry: CollectionEntry<'articles'>;
  prevArticle: CollectionEntry<'articles'> | null;
  nextArticle: CollectionEntry<'articles'> | null;
  allArticles: CollectionEntry<'articles'>[];
};

const { entry, prevArticle, nextArticle, allArticles } = Astro.props;
const { Content, headings } = await render(entry);
const translation = getTranslation(entry, allArticles);

// Find related articles (same category, excluding current)
const relatedArticles = allArticles
  .filter(a => a.data.lang === entry.data.lang && a.data.category === entry.data.category && a.id !== entry.id)
  .slice(0, 3);

// Estimate reading time (rough: ~400 chars/min for Chinese, ~200 words/min for English)
const body = entry.body || '';
const readingTime = entry.data.lang === 'zh'
  ? Math.max(1, Math.ceil(body.length / 400))
  : Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 200));
---

<ArticleLayout
  frontmatter={entry.data}
  headings={headings}
  prevArticle={prevArticle ? { id: prevArticle.id, title: prevArticle.data.title } : null}
  nextArticle={nextArticle ? { id: nextArticle.id, title: nextArticle.data.title } : null}
  relatedArticles={relatedArticles.map(a => ({
    id: a.id,
    title: a.data.title,
    description: a.data.description,
    publishedAt: a.data.publishedAt,
    category: a.data.category,
    tags: a.data.tags,
  }))}
  readingTime={readingTime}
  translation={translation ? { id: translation.id, lang: translation.data.lang } : null}
>
  <Content />
</ArticleLayout>
