---

<footer class="border-t border-gray-200/80 bg-gradient-to-b from-white to-gray-50/80 py-8 md:py-10">
  <div class="mx-auto max-w-[90rem] px-6">
    <div class="grid gap-6 md:grid-cols-[1.2fr_1fr_1fr] md:gap-10 lg:gap-14">
      <!-- Brand column -->
      <div>
        <a href="/" class="font-display text-lg font-semibold tracking-tight text-gray-900">
          Bruce Cheng
        </a>
        <p class="mt-2.5 max-w-sm text-sm leading-6 text-gray-500" id="footer-tagline">
          Turning complex enterprise workflows into secure, reliable AI products teams can trust and use.
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <p class="mb-2.5 text-[0.7rem] font-semibold uppercase tracking-[0.24em] text-gray-600" id="footer-links-label">
          Quick Links
        </p>
        <nav class="flex flex-col gap-0.5">
          <a href="/" class="inline-flex min-h-11 items-center text-sm text-gray-600 transition-colors hover:text-primary md:min-h-8" id="footer-link-home">Home</a>
          <a href="/resume" class="inline-flex min-h-11 items-center text-sm text-gray-600 transition-colors hover:text-primary md:min-h-8" id="footer-link-resume">Resume & CV</a>
          <a href="/uses" class="inline-flex min-h-11 items-center text-sm text-gray-600 transition-colors hover:text-primary md:min-h-8" id="footer-link-uses">Tech Stack</a>
          <a href="/projects" class="inline-flex min-h-11 items-center text-sm text-gray-600 transition-colors hover:text-primary md:min-h-8" id="footer-link-projects">Projects</a>
          <a href="/timeline" class="inline-flex min-h-11 items-center text-sm text-gray-600 transition-colors hover:text-primary md:min-h-8" id="footer-link-timeline">Timeline</a>
        </nav>
      </div>

      <!-- Connect -->
      <div>
        <p class="mb-2.5 text-[0.7rem] font-semibold uppercase tracking-[0.24em] text-gray-600" id="footer-connect-label">
          Connect
        </p>
        <div class="flex flex-col gap-0.5">
          <a href="https://github.com/bruce-lcz" target="_blank" rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 text-sm text-gray-600 transition-colors hover:text-primary md:min-h-8">
            <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a href="https://www.linkedin.com/in/bruce-lcz" target="_blank" rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 text-sm text-gray-600 transition-colors hover:text-primary md:min-h-8">
            <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
          <a href="mailto:bruce.zheng0814@gmail.com"
            class="inline-flex min-h-11 items-center gap-2 text-sm text-gray-600 transition-colors hover:text-primary md:min-h-8">
            <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Email
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-6 flex flex-col items-center justify-between gap-4 border-t border-gray-200/80 pt-4 sm:flex-row">
      <p class="text-sm text-gray-500" id="footer-copyright">
        © {new Date().getFullYear()} Bruce Cheng. Designed and built with care.
      </p>
    </div>
  </div>
</footer>

<script>
  // Sync footer language with stored preference
  function updateFooterLang() {
    const lang = localStorage.getItem('language') || 'en';
    const isZh = lang === 'zh';

    const tagline = document.getElementById('footer-tagline');
    const linksLabel = document.getElementById('footer-links-label');
    const connectLabel = document.getElementById('footer-connect-label');
    const linkHome = document.getElementById('footer-link-home');
    const linkResume = document.getElementById('footer-link-resume');
    const linkUses = document.getElementById('footer-link-uses');
    const linkProjects = document.getElementById('footer-link-projects');
    const linkTimeline = document.getElementById('footer-link-timeline');
    const copyright = document.getElementById('footer-copyright');

    if (tagline) tagline.textContent = isZh
      ? '把複雜的企業流程，轉成安全可靠、團隊信任也願意持續使用的 AI 產品。'
      : 'Turning complex enterprise workflows into secure, reliable AI products teams can trust and use.';
    if (linksLabel) linksLabel.textContent = isZh ? '快速連結' : 'Quick Links';
    if (connectLabel) connectLabel.textContent = isZh ? '聯絡方式' : 'Connect';
    if (linkHome) linkHome.textContent = isZh ? '首頁' : 'Home';
    if (linkResume) linkResume.textContent = isZh ? '履歷與 CV' : 'Resume & CV';
    if (linkUses) linkUses.textContent = isZh ? '技術與工具' : 'Tech Stack';
    if (linkProjects) linkProjects.textContent = isZh ? '專案' : 'Projects';
    if (linkTimeline) linkTimeline.textContent = isZh ? '時間軸' : 'Timeline';
    if (copyright) copyright.textContent = isZh
      ? `© ${new Date().getFullYear()} Bruce Cheng. 用心設計、開發。`
      : `© ${new Date().getFullYear()} Bruce Cheng. Designed and built with care.`;
  }

  updateFooterLang();

  // Listen for storage changes from other components
  window.addEventListener('storage', updateFooterLang);
  window.addEventListener('languagechange', updateFooterLang);
</script>
