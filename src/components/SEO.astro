---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  type?: string;
  author?: string;
  lang?: 'en' | 'zh';
  alternateEn?: string;
  alternateZh?: string;
}

const {
  title = "Bruce Cheng",
  description = "Bruce Cheng - Portfolio & Knowledge Base",
  image = "/assets/avatar.png",
  article = false,
  publishedAt,
  updatedAt,
  tags = [],
  type = "website",
  author = "Bruce Cheng",
  lang = 'en',
  alternateEn,
  alternateZh,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogType = article ? "article" : type;
const resolvedImage = new URL(image, Astro.site);

const jsonLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description: description,
      image: resolvedImage.toString(),
      author: {
        "@type": "Person",
        name: author,
      },
      datePublished: publishedAt ? publishedAt.toISOString() : undefined,
      dateModified: updatedAt ? updatedAt.toISOString() : (publishedAt ? publishedAt.toISOString() : undefined),
      inLanguage: lang === 'zh' ? 'zh-TW' : 'en',
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: title,
      url: canonicalURL.toString(),
      description: description,
      author: {
        "@type": "Person",
        name: author,
      },
    };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{alternateEn && <link rel="alternate" hreflang="en" href={new URL(alternateEn, Astro.site)} />}
{alternateZh && <link rel="alternate" hreflang="zh-TW" href={new URL(alternateZh, Astro.site)} />}
{alternateEn && <link rel="alternate" hreflang="x-default" href={new URL(alternateEn, Astro.site)} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta property="og:locale" content={lang === 'zh' ? 'zh_TW' : 'en_US'} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImage} />
{article && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{article && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={resolvedImage} />

<!-- JSON-LD -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
