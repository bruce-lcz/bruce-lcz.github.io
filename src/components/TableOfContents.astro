---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

// Only show h2 and h3 headings in TOC
const tocItems = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

{tocItems.length > 0 && (
  <nav id="table-of-contents" class="toc" aria-label="Table of contents">
    <!-- Desktop: sticky sidebar -->
    <div class="hidden lg:block">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-gray-400 mb-4">
        On this page
      </p>
      <div class="relative before:absolute before:bottom-0 before:left-[0.34rem] before:top-0 before:w-px before:bg-gray-200">
        <ul class="space-y-1">
          {tocItems.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class:list={[
                  'toc-link group relative flex items-center gap-2.5 py-1.5 text-sm transition-all duration-200',
                  heading.depth === 3 ? 'pl-5' : 'pl-0',
                ]}
                data-heading-slug={heading.slug}
              >
                <span
                  class:list={[
                    'toc-dot relative z-10 shrink-0 rounded-full border border-white transition-all duration-300',
                    heading.depth === 2 ? 'h-2.5 w-2.5 bg-gray-300 group-hover:bg-gray-500' : 'h-2 w-2 bg-gray-200 group-hover:bg-gray-400',
                  ]}
                />
                <span class="toc-text leading-snug text-gray-500 group-hover:text-gray-800 transition-colors duration-200 line-clamp-2">
                  {heading.text}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Mobile: collapsible at top -->
    <div class="lg:hidden mb-8">
      <details class="rounded-[20px] border border-gray-200 bg-gray-50/80">
        <summary class="flex cursor-pointer items-center justify-between px-5 py-3.5 text-sm font-semibold text-gray-700 select-none">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
            <span id="toc-mobile-label">Table of Contents</span>
          </span>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200 details-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <ul class="px-5 pb-4 space-y-0.5">
          {tocItems.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class:list={[
                  'block py-1.5 text-sm text-gray-500 hover:text-primary transition-colors',
                  heading.depth === 3 ? 'pl-4' : '',
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
)}

<script>
  // Scroll tracking for TOC highlights (desktop)
  const tocLinks = document.querySelectorAll('.toc-link');
  if (tocLinks.length > 0) {
    const headingSlugs = Array.from(tocLinks).map(
      (link) => (link as HTMLElement).dataset.headingSlug!
    );

    const headingElements = headingSlugs
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => !!el);

    if (headingElements.length > 0) {
      let activeSlug = headingSlugs[0];

      function updateActiveToc() {
        const scrollY = window.scrollY;
        const offset = 100; // Account for sticky navbar

        // Find the heading that's currently at the top of the viewport
        let currentSlug = headingSlugs[0];
        for (let i = 0; i < headingElements.length; i++) {
          const el = headingElements[i];
          if (el.offsetTop - offset <= scrollY) {
            currentSlug = headingSlugs[i];
          }
        }

        if (currentSlug !== activeSlug) {
          activeSlug = currentSlug;

          tocLinks.forEach((link) => {
            const slug = (link as HTMLElement).dataset.headingSlug;
            const dot = link.querySelector('.toc-dot');
            const text = link.querySelector('.toc-text');
            const isActive = slug === activeSlug;

            if (dot) {
              if (isActive) {
                dot.classList.remove('bg-gray-300', 'bg-gray-200');
                dot.classList.add('bg-primary', 'scale-110');
                (dot as HTMLElement).style.boxShadow = '0 0 0 4px rgba(26, 115, 232, 0.10)';
              } else {
                dot.classList.remove('bg-primary', 'scale-110');
                dot.classList.add(dot.classList.contains('h-2') ? 'bg-gray-200' : 'bg-gray-300');
                (dot as HTMLElement).style.boxShadow = '';
              }
            }
            if (text) {
              if (isActive) {
                text.classList.remove('text-gray-500');
                text.classList.add('text-gray-900', 'font-medium');
              } else {
                text.classList.remove('text-gray-900', 'font-medium');
                text.classList.add('text-gray-500');
              }
            }
          });
        }
      }

      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            updateActiveToc();
            ticking = false;
          });
        }
      }, { passive: true });

      updateActiveToc();
    }
  }

  // Language sync for mobile TOC label
  function updateTocLang() {
    const lang = localStorage.getItem('language') || 'en';
    const label = document.getElementById('toc-mobile-label');
    if (label) label.textContent = lang === 'zh' ? '目錄' : 'Table of Contents';
  }
  updateTocLang();
  window.addEventListener('storage', updateTocLang);
</script>

<style>
  details[open] .details-chevron {
    transform: rotate(180deg);
  }
</style>
