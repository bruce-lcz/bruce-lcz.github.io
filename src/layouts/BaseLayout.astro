---
import '../index.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  type?: string;
  author?: string;
  isHomepage?: boolean;
  hideNavbar?: boolean;
  hideFooter?: boolean;
}

const {
  isHomepage = false,
  hideNavbar = false,
  hideFooter = false,
  ...seoProps
} = Astro.props;
---

<html lang="zh-TW">
  <head>
    <SEO {...seoProps} />

  </head>
  <body class="bg-white text-gray-900 min-h-screen flex flex-col antialiased">
    {!hideNavbar && <Navbar isHomepage={isHomepage} />}

    <main class="flex-1">
      <slot />
    </main>

    {!hideFooter && <Footer />}
  </body>
</html>
